{
  "name": "elixir-ui",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.2.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "lint-staged": "lint-staged",
    "format": "turbo format",
    "format:check": "turbo format -- --check",
    "typecheck": "turbo typecheck",
    "prepare": "husky install",
    "registry": "bun --cwd packages/cli scripts/generate-registry.ts",
    "postinstall": "turbo run build --filter=@workspace/ui"
  },
    "exports": {
    "./*": "./*"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
