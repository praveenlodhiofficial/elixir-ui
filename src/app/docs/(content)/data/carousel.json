{
  "carousel1": {
    "title": "Carousel #1",
    "description": "A versatile carousel component with multiple interface views (web, phone, SMS) that allows users to switch between different display modes.",
    "componentPath": "src/registry/components/carousel1.tsx",
    "previewPath": "src/app/docs/(content)/preview/carousel1.tsx",
    "category": "Carousel",
    "tags": ["carousel", "interface", "responsive", "interactive"],
    "installation": {
      "cliSteps": [
        {
          "step": 1,
          "title": "Install via CLI",
          "code": "npx shadcn add https://elixir-ui-xi.vercel.app/registry/carousel1.json"
        }
      ],
      "manualSteps": [
        {
          "step": 1,
          "title": "Copy component file",
          "code": "Copy carousel1.tsx to your components directory"
        },
        {
          "step": 2,
          "title": "Install dependencies",
          "code": "npm install @radix-ui/react-slot"
        },
        {
          "step": 3,
          "title": "Import and use",
          "code": "import { Carousel1 } from '@/components/carousel1'"
        }
      ]
    },
    "usage": {
      "steps": [
        {
          "step": 1,
          "title": "Import the component",
          "code": "import { Carousel1 } from '@/components/carousel1'"
        },
        {
          "step": 2,
          "title": "Use in your JSX",
          "code": "<Carousel1 />"
        },
        {
          "step": 3,
          "title": "Customize as needed",
          "code": "Add your own content and styling"
        }
      ]
    },
    "features": [
      "Multiple interface views (Web, Phone, SMS)",
      "Interactive category switching",
      "Responsive design",
      "Customizable styling",
      "Smooth transitions"
    ],
    "dependencies": [
      "@radix-ui/react-slot",
      "react",
      "tailwindcss"
    ]
  },
