      "cliSteps": [
        {
          "step": 1,
          "title": "Install via CLI",
          "code": "npx shadcn add https://elixir-ui-xi.vercel.app/registry/carousel2.json"
        }
      ],
      "manualSteps": [
        {
          "step": 1,
          "title": "Copy component file",
          "code": "Copy carousel2.tsx to your components directory"
        },
        {
          "step": 2,
          "title": "Install dependencies",
          "code": "npm install @radix-ui/react-slot"
        },
        {
          "step": 3,
          "title": "Import and use",
